# ── Copy this file to `.env` and fill in real values. Never commit `.env`. ──

# ── Environment ───────────────────────────────────────────────────────
# "production" enforces COOKIE_SECURE=true, a strong ADMIN_PASSWORD and an
# LLM key (fatal on boot otherwise), and disables /docs, /redoc, /openapi.
APP_ENV=development

# ── LLM provider ──────────────────────────────────────────────────────
# auto = OpenAI when its key is set, else the Claude API. Or pin one:
# LLM_PROVIDER=openai | anthropic
# stub = deterministic offline extractor (no keys/network) for E2E tests and
#        keyless local demos — refused in production. See docs/E2E.md.
LLM_PROVIDER=auto

# OpenAI — Structured Output extraction
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-2024-08-06

# Claude API (Anthropic) — structured-output extraction alternative
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Azure AI Document Intelligence — used as OCR fallback for scanned / table-heavy PDFs
AZURE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_KEY=<your-azure-document-intelligence-key>

# Pipeline tuning (optional — sensible defaults are applied if omitted)
# Minimum extractable characters per page before a page counts as "digital"
DIGITAL_MIN_CHARS_PER_PAGE=150
# If this fraction of pages (or more) fails the digital check, route to Azure OCR
SCANNED_PAGE_RATIO=0.4
# Hard cap on upload size in megabytes
MAX_UPLOAD_MB=25
# Reject PDFs longer than this before any paid API call
MAX_PDF_PAGES=60

# ── Deployment (BRD 2.9/2.10/2.11) ──────────────────────────────
# First user, seeded on startup when no users exist (no self-registration).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Documents, exports and the app SQLite DB (default: <repo>/data)
DATA_DIR=
# Project store (see docs/DATABASE.md): PostgreSQL in production — paste the
# Supabase "Connect → URI" string. Empty = SQLite at DATA_DIR/projects.db
# (development/tests only; production refuses to boot without PostgreSQL).
DATABASE_URL=
# Set true behind HTTPS in production
COOKIE_SECURE=false
SESSION_TTL_HOURS=72
# Auth hardening (see docs/AUTH.md)
INACTIVITY_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Data retention (see docs/DATA_RETENTION.md): hard-delete projects untouched
# for this many days. 0 = disabled (keep forever) — the client sets the period.
RETENTION_DAYS=0

# ── Supabase Auth (Next.js frontend in web/, see docs/AUTH.md) ─────
# The web app signs in with Supabase and sends its access token as a Bearer
# header; the backend verifies it locally. Leave both empty to disable.
# Project origin only (no path); must be https in production (fatal on boot).
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy HS256 JWT secret (Dashboard → Project Settings → API → JWT). With it
# empty, tokens are verified against the project's JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=
# Expected `aud` claim (Supabase default; change only if the project differs).
SUPABASE_JWT_AUDIENCE=authenticated

# ── Backups (see docs/BACKUP.md) ────────────────────────────────
BACKUP_ENCRYPTION_KEY=
# Offsite: an S3-compatible bucket OR a directory
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_OFFSITE_DIR=
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_ALERT_WEBHOOK=

# ── Observability (see docs/OBSERVABILITY.md) ───────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
DISK_FREE_MIN_RATIO=0.10
# Alerts (backup/integrity/disk) reuse BACKUP_ALERT_WEBHOOK above.

# ── LLM data-processing posture (see docs/DATA_PROCESSING.md) ────
LLM_ALLOWED_HOSTS=api.anthropic.com,api.openai.com
LLM_NO_TRAINING_ACK=false
