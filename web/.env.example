# Copy to `.env.local` for local overrides. Never commit `.env.local`.

# ── Backend proxy ─────────────────────────────────────────────────────
# Where Next.js proxies `/api/*` (server-side only; not exposed to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Base path the browser API client prefixes onto every request. Keep `/api`
# so calls stay same-origin. Set an absolute URL only if you deliberately call
# the backend cross-origin (that also requires CORS on the backend).
NEXT_PUBLIC_API_BASE_URL=/api

# ── Supabase Auth (S1 login) ──────────────────────────────────────────
# Project URL and anon/publishable key are public by design (RLS and Auth
# settings protect the project). Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Service-role key: ONLY for the admin scripts (`npm run users`). Never
# prefix it NEXT_PUBLIC_, never ship it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# In the Supabase dashboard, also turn OFF "Allow new users to sign up"
# (Authentication → Sign In / Providers → Email) so the anon key cannot be
# used to self-register from outside this app. See web/README.md.
