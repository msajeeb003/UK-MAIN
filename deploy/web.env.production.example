# ── Web (Next.js) environment for production ───────────────────────────
# Runtime (server-side): where Next proxies /api/* — the backend's private
# address on the same network/host. Never the public internet if avoidable.
BACKEND_URL=http://backend:8000

# Build-time (public by design — baked into the bundle):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
NEXT_PUBLIC_API_BASE_URL=/api

# Admin scripts only (`npm run users -- …`), never in the browser bundle:
SUPABASE_SERVICE_ROLE_KEY=
