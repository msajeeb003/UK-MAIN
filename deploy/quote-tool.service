[Unit]
Description=Insurance Quote Comparison Tool (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/quote-tool
ExecStart=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
