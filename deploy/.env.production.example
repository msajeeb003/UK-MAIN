# ── Backend environment for production ─────────────────────────────────
# Copy to the host as `.env` (VPS: /opt/quote-tool/.env) or paste the
# values into the platform's variables screen (Fly: `fly secrets set`,
# Railway: Variables). Never commit a filled-in copy.
#
# Production start-up refuses to boot unless: APP_ENV=production,
# COOKIE_SECURE=true, an LLM key, LLM_NO_TRAINING_ACK=true, DATABASE_URL on
# PostgreSQL, SUPABASE_URL over https, and SUPABASE_SERVICE_ROLE_KEY.

APP_ENV=production
COOKIE_SECURE=true
# Trust X-Forwarded-For from the platform edge / Caddy (client IP for the
# login lockout and rate limit). "*" when only the proxy can reach the port.
FORWARDED_ALLOW_IPS=*
WORKERS=2
LOG_LEVEL=info

# ── Supabase (project in a UK/EU region: eu-west-2 London or eu-west-1 Ireland)
# Dashboard → Project Settings → API / Database.
SUPABASE_URL=https://<project-ref>.supabase.co
# Auth: EITHER the legacy JWT secret (Project Settings → API → JWT) …
SUPABASE_JWT_SECRET=
# … or leave it empty to verify tokens against the project JWKS via SUPABASE_URL.
SUPABASE_JWT_AUDIENCE=authenticated
# Storage: service-role key (server-side only) + a PRIVATE bucket.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Project store — Dashboard → Connect → "Session pooler" URI, then add
# ?sslmode=require. Percent-encode special characters in the password
# (! → %21, + → %2B, @ → %40, # → %23). The direct host (db.<ref>…:5432)
# is IPv6-only: use it only from a host with IPv6 egress.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Admin role for /config/* (insurer list, terminology) ─────────────
# Supabase users with app_metadata.role = "admin" (web: `npm run users -- role <email> admin`)
# and/or these comma-separated emails.
ADMIN_EMAILS=

# ── LLM provider (documents leave the host for extraction — see docs/DATA_PROCESSING.md)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_API_KEY=
LLM_ALLOWED_HOSTS=api.anthropic.com,api.openai.com
# Set true once the provider's no-training / zero-retention terms are filed.
LLM_NO_TRAINING_ACK=true

# ── Scanned PDFs (OCR): Azure Document Intelligence in a UK/EU region
# (e.g. uksouth, westeurope), or rebuild the image with INSTALL_OCR=1.
AZURE_ENDPOINT=
AZURE_KEY=

# ── Storage on the host (app SQLite DB: users/sessions for the classic
# SPA, document metadata, jobs, audit log; exports; documents only when
# Supabase Storage is off). Mount a persistent, encrypted volume here.
DATA_DIR=/data

# ── Classic SPA first user (optional when everyone signs in via Supabase)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=72
INACTIVITY_TIMEOUT_MINUTES=60

# ── Retention (BRD 2.11) — 0 keeps everything until the client decides
RETENTION_DAYS=0

# ── Backups of DATA_DIR (docs/BACKUP.md). Projects/config live in Supabase
# (covered by its backups / PITR); this covers the app DB + files.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=eu-west-2
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_ALERT_WEBHOOK=

# ── Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
DISK_FREE_MIN_RATIO=0.10

# ── Guard rails
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=60
RATE_LIMIT_PER_MINUTE=30
